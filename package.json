{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run typecheck:app && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "sources:test": "node --test tests/job-sources.test.mjs",
    "db:generate": "drizzle-kit generate",
    "agent:setup": "uv sync --project services/agent --locked",
    "agent:test": "uv run --project services/agent --locked pytest services/agent/tests && node --test tests/job-search-route.test.mjs tests/knowledge-route.test.mjs",
    "agent:check": "uv run --project services/agent --locked ruff check services/agent && uv run --project services/agent --locked ruff format --check services/agent",
    "agent:demo": "uv run --project services/agent --locked getoffers-agent demo",
    "agent:eval": "uv run --project services/agent --locked getoffers-agent evaluate",
    "search": "uv run --project services/agent --locked getoffers-search",
    "search:setup:neural": "uv sync --project services/agent --locked --extra neural",
    "knowledge": "uv run --project services/agent --locked --no-sync getoffers-knowledge",
    "knowledge:setup": "uv sync --project services/agent --locked --extra neural --extra documents --extra r2",
    "career": "services/agent/.venv/bin/python -m getoffers_agent.career.server",
    "career:test": "services/agent/.venv/bin/pytest services/agent/tests/test_career_discovery.py && node --test tests/career-route.test.mjs",
    "career:eval": "services/agent/.venv/bin/python -m getoffers_agent.career.evaluation",
    "assistant": "services/agent/.venv/bin/python -m getoffers_agent.assistant.server",
    "assistant:test": "services/agent/.venv/bin/pytest services/agent/tests/test_assistant.py services/agent/tests/test_assistant_evaluation.py services/agent/tests/test_codex_local.py && node --test tests/assistant-route.test.mjs tests/local-codex.test.mjs tests/assistant-history.test.mjs tests/local-session.test.mjs",
    "assistant:eval": "services/agent/.venv/bin/python -m getoffers_agent.assistant.evaluation",
    "assistant:local": "services/agent/.venv/bin/python scripts/assistant-local.py",
    "assistant:developer": "services/agent/.venv/bin/python scripts/assistant-local.py --developer"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.34.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
