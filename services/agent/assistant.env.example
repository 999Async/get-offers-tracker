# Copy to .env.assistant (gitignored). Values are read as text, never as shell commands.
# Use a service/model that supports the current Chat Completions tool-calling adapter.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=3000
# Optional USD prices per million tokens. Leave blank if unknown.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
